    { "name": "manual becomes equal to another tile", "frames": 1, "tiles": [[[0, 0, "ff0000"]], [[0, 0, "0000ff"]]],
      "layers": [[[[1, 1, 2]]]], "strokes": [{ "mode": "manual", "points": [[8, 0]], "color": "ff0000" }] },
    { "name": "manual erase a whole tile", "frames": 1, "tiles": [[[0, 0, "ff0000"]], [[0, 0, "0000ff"]]],
