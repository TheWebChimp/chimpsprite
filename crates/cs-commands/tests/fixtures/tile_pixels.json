    { "name": "manual on a flipped cell", "frames": 1, "tiles": [[[0, 0, "ff0000"]], [[0, 0, "0000ff"]]],
      "layers": [[[["1x", 2]]]], "strokes": [{ "mode": "manual", "points": [[1, 1]], "color": "0000ff" }] },
    { "name": "manual without a cel", "frames": 1, "tiles": [[[0, 0, "ff0000"]], [[0, 0, "0000ff"]]],
      "layers": [[]], "strokes": [{ "mode": "manual", "points": [[5, 1]], "color": "0000ff" }] },

