tile 1: 0,0=ff0000ff
tile 2: 0,0=0000ffff
tile 3: 3,0=ff0000ff 1,1=0000ffff
L1 F1 (0,0) 3 2
== stack paint without change
tile 1: 0,0=ff0000ff
tile 2: 0,0=0000ffff
L1 F1 (0,0) 1 2
== stack two equal new cells
tile 1: 0,0=ff0000ff
tile 2: 0,0=0000ffff
tile 3: 0,1=0000ffff 1,1=0000ffff 2,1=0000ffff 3,1=0000ffff
L1 F1 (0,0) 3 3
== flips x: stack builds a flipped copy
tile 1: 0,0=ff0000ff 1,0=00ff00ff
tile 2: 0,0=0000ffff
tile 3: 3,0=ff0000ff
L1 F1 (0,0) 2 1x 1
== flips x: no match for flip y
tile 1: 0,0=ff0000ff 1,0=00ff00ff
tile 2: 0,0=0000ffff
tile 3: 0,3=ff0000ff
tile 4: 0,3=ff0000ff 1,3=00ff00ff
L1 F1 (0,0) 2 4 1
== flips xyd: flip y
tile 1: 0,0=ff0000ff 1,0=00ff00ff
tile 2: 0,0=0000ffff
tile 3: 0,3=ff0000ff
L1 F1 (0,0) 2 1y 1
== flips xyd: flip d
tile 1: 0,0=ff0000ff 1,0=00ff00ff
tile 2: 0,0=0000ffff
tile 3: 0,0=ff0000ff
L1 F1 (0,0) 2 1d 1
== flips xyd: rotated 90 clockwise
tile 1: 0,0=ff0000ff 1,0=00ff00ff
tile 2: 0,0=0000ffff
tile 3: 3,0=ff0000ff
L1 F1 (0,0) 2 1xd 1
== flips xyd: rotated 180
tile 1: 0,0=ff0000ff 1,0=00ff00ff
tile 2: 0,0=0000ffff
tile 3: 3,3=ff0000ff
L1 F1 (0,0) 2 1xy 1
== flips xyd: rotated 90 counterclockwise
tile 1: 0,0=ff0000ff 1,0=00ff00ff
tile 2: 0,0=0000ffff
tile 3: 0,3=ff0000ff
L1 F1 (0,0) 2 1yd 1
== flips xyd: anti-diagonal
tile 1: 0,0=ff0000ff 1,0=00ff00ff
tile 2: 0,0=0000ffff
tile 3: 3,3=ff0000ff
L1 F1 (0,0) 2 1xyd 1
== flips xyd: symmetric tile prefers x
tile 1: 0,0=ff0000ff 3,3=ff0000ff
tile 2: 0,0=0000ffff
tile 3: 3,0=ff0000ff
L1 F1 (0,0) 2 1x 1
== flips xyd: symmetric tile prefers y
tile 1: 0,0=ff0000ff 3,0=ff0000ff
tile 2: 0,0=0000ffff
tile 3: 0,3=ff0000ff
L1 F1 (0,0) 2 1y 1
== flips xyd: symmetric tile prefers xy
tile 1: 0,0=ff0000ff 1,0=ff0000ff 0,1=ff0000ff
tile 2: 0,0=0000ffff
tile 3: 3,3=ff0000ff
tile 4: 2,3=ff0000ff 3,3=ff0000ff
L1 F1 (0,0) 2 1xy 1
== flips xyd: auto reuses a flipped tile
tile 1: 0,0=ff0000ff
L1 F1 (0,0) 1 1x
