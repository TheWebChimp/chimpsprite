tile 1: 0,0=ff0000ff
tile 2: 0,0=0000ffff
tile 3: 0,0=ff0000ff 1,1=0000ffff
L1 F1 (0,0) 3 1 2
== stack unique tile
tile 1: 0,0=ff0000ff
tile 2: 0,0=0000ffff
tile 3: 0,0=0000ffff 1,1=0000ffff
L1 F1 (0,0) 1 1 3
== stack outside the grid
tile 1: 0,0=ff0000ff
tile 2: 0,0=0000ffff
tile 3: 1,1=0000ffff
L1 F1 (0,0) 1 1 2 3
== stack stroke over two instances
tile 1: 0,0=ff0000ff
tile 2: 0,0=0000ffff
tile 3: 0,0=ff0000ff 1,1=0000ffff 2,1=0000ffff 3,1=0000ffff
tile 4: 0,0=ff0000ff 0,1=0000ffff 1,1=0000ffff
L1 F1 (0,0) 3 4 2
== stack becomes equal to another tile
tile 1: 0,0=ff0000ff
tile 2: 0,0=0000ffff
L1 F1 (0,0) 1 1 1
== stack erase a whole tile
tile 1: 0,0=ff0000ff
tile 2: 0,0=0000ffff
L1 F1 (0,0) 1 1 0
== stack two strokes
tile 1: 0,0=ff0000ff
tile 2: 0,0=0000ffff
tile 3: 0,0=0000ffff 1,1=0000ffff
tile 4: 0,0=0000ffff 1,1=0000ffff 2,1=0000ffff
L1 F1 (0,0) 1 1 4
